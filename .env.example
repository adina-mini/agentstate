# AgentGate environment variables
# Copy this to .env and fill in your values

# === LLM ===
GROQ_API_KEY=your_groq_api_key_here

# Model to use (Groq model IDs)
LLM_MODEL=llama-3.1-70b-versatile
LLM_TEMPERATURE=0.1

# === GitHub Connector ===
# Optional: increases rate limit from 60 to 5000 req/hr
GITHUB_TOKEN=

# === Embedding Model ===
# Runs locally on CPU, no API key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === ChromaDB ===
CHROMA_PERSIST_DIR=./data/chroma

# === SQLite ===
SQLITE_DB_PATH=./data/agentgate.db

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8000

# === MCP Server ===
MCP_TRANSPORT=stdio
